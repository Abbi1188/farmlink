# Copy this file to backend/.env and change the values.
# Never commit the real .env file.

APP_NAME=FarmLink
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default is a SQLite file at database/farmlink.db (good for development).
# For PostgreSQL use something like:
# DATABASE_URL=postgresql+psycopg2://farmlink:password@localhost:5432/farmlink

# Farmers must be approved by an admin before publishing stock.
REQUIRE_FARM_APPROVAL=true

# Frontend settings (set as environment variables when running the Flask app)
# API_URL=http://localhost:8000
# FLASK_SECRET_KEY=change-this-too
